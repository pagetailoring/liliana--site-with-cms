---
import type { GetStaticPaths } from 'astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import PageBody from '../components/islands/PageBody.astro';
import { getConfig, getPage } from '../lib/data';
import { islands } from '../lib/islands';

// Use the repository for the route list. Tina resolves each document's content
// both at build time and when the editor refreshes its preview.
export const getStaticPaths = (() => {
  const documents = import.meta.glob('/src/content/page/**/*.json');
  return Object.keys(documents).map((file) => {
    const relativePath = file.slice('/src/content/page/'.length);
    const slug = relativePath.slice(0, -'.json'.length);
    return {
      params: { slug: slug === 'home' ? undefined : slug },
      props: { relativePath },
    };
  });
}) satisfies GetStaticPaths;

const { relativePath } = Astro.props;
const [page, settings] = await Promise.all([
  getPage(relativePath),
  getConfig(),
]);
const data = page.data.page;
if (!data) throw new Error(`Could not load the page at ${relativePath}`);
const title = `${data.title} | ${settings.data.config.title}`;
const description = data.description || settings.data.config.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <TinaIsland
      name="page"
      wrapper={islands.page.wrapper}
      params={{ path: relativePath }}
      primary
    >
      <PageBody data={data} />
    </TinaIsland>
  </body>
</html>
