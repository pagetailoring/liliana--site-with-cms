{
  "name": "liliana-gd",
  "type": "module",
  "version": "1.2.1",
  "author": "pagetailoring",
  "repository": {
    "type": "git",
    "url": "https://github.com/pagetailoring/liliana--site-with-cms"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "build": "tinacms build --content=local -c \"astro build\"",
    "build:local": "tinacms build --local --skip-cloud-checks -c \"astro build\"",
    "preview": "wrangler dev",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm check",
    "deploy": "wrangler deploy",
    "test:cms": "playwright test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/sitemap": "^3.7.6",
    "@tinacms/astro": "^0.8.0",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.1",
    "@tinacms/cli": "^4.0.5",
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tinacms": "^3.15.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "wrangler": "^4.168.0"
  },
  "packageManager": "pnpm@10.15.1"
}
