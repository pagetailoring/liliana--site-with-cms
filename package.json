{
  "name": "liliana-gd",
  "type": "module",
  "version": "1.2.1",
  "author": "pagetailoring",
  "repository": {
    "type": "git",
    "url": "https://github.com/pagetailoring/liliana--site-with-cms"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "build": "tinacms build --content=local -c \"astro build\"",
    "build:local": "tinacms build --local --skip-cloud-checks -c \"astro build\"",
    "build:search": "tinacms search-index",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/mdx": "^6.0.2",
    "@astrojs/netlify": "^7.0.13",
    "@astrojs/node": "^10.1.4",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^10.0.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@iconify-json/tabler": "^1.2.35",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@tinacms/astro": "^0.8.0",
    "astro": "^6.4.4",
    "astro-icon": "^1.1.5",
    "clsx": "^2.1.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tinacms/cli": "^4.0.4",
    "@types/node": "^24.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tinacms": "^3.15.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "eslint": "^10.15.0",
    "@eslint/js": "^10.0.0",
    "typescript-eslint": "^8.74.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "globals": "^17.0.0"
  },
  "packageManager": "pnpm@10.15.1"
}
